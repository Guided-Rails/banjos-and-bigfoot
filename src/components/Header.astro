---
const { title } = Astro.props;
---

<header>
	<div class="container">
		<a href="/" class="brand">{title}</a>
	</div>
</header>

<style>
	header {
		border-top: 8px solid var(--brand);
	}

	.container {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: min(100vw - 3rem, 80rem);
		margin-inline: auto;
		padding-block: 1.5rem;
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--brand);
		font-size: 1.125rem;
		line-height: 1.75rem;
		font-weight: 600;
		letter-spacing: -0.025em;
		text-decoration: none;
	}
</style>
